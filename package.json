{
  "name": "validuo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "npm run dev -w @validuo/app --",
    "build": "npm run build -w @validuo/app",
    "start": "npm run start -w @validuo/app --",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db": "npm run mikro-orm -w @validuo/db --",
    "db:migration:create": "npm run mikro-orm -w @validuo/db -- migration:create",
    "db:migrate": "npm run mikro-orm -w @validuo/db -- migration:up",
    "db:migration:down": "npm run mikro-orm -w @validuo/db -- migration:down",
    "db:migration:list": "npm run mikro-orm -w @validuo/db -- migration:list"
  },
  "devDependencies": {
    "@types/node": "^24",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
