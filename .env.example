# Copy to .env (or .env.local) in the repository root. Loaded by Next.js (packages/app) and the
# database tooling through the shared loader (@validuo/core/config/load-env); validated by
# parseServerEnv (@validuo/core/config). Only safe example values belong in this file.

# Runtime connection: a least-privilege role (no SUPERUSER, no BYPASSRLS, not the table owner).
DATABASE_URL=postgres://validuo_app:change-me@127.0.0.1:5432/validuo

# Connection pool (optional, defaults 0 / 10)
DB_POOL_MIN=0
DB_POOL_MAX=10

# SQL query logging (optional, default false)
DB_DEBUG=false

# Migration account (table owner) used by the MikroORM CLI (`npm run db:migrate` etc.).
# Optional: defaults to DATABASE_URL, which is fine locally; set a separate account elsewhere.
# MIGRATION_DATABASE_URL=postgres://validuo_owner:change-me@127.0.0.1:5432/validuo

# Integration tests only read TEST_DATABASE_URL from the shell environment (never .env files and
# never DATABASE_URL). It must point at a disposable database whose name contains "test", e.g.:
#   TEST_DATABASE_URL=postgres://postgres:change-me@127.0.0.1:5432/validuo_test npm run test:integration
