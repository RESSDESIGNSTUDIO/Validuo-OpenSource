# Skopiuj do .env (lub .env.local) w katalogu głównym repozytorium.
# Plik jest wczytywany przez Next.js (packages/app) i CLI MikroORM (packages/db).

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/validuo

# Pula połączeń MikroORM (opcjonalnie)
DB_POOL_MIN=0
DB_POOL_MAX=10

# Logowanie zapytań SQL (opcjonalnie)
DB_DEBUG=false
